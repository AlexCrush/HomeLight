; Shared L7 helpers (slave + ring)
Link_ProcessSlaveData:
    lds tmp, LampStateKnown
    lds tmp1, LampStateKnownExt
    cp tmp1, tmp
    brcs Link_ProcessSlaveData_SkipLampDataUse
    sts LampStateKnown, tmp1
    LDIRamAddrZ LampStateExt
    LDIRamAddrY LampState
    rcall Lamp_CopyZToY
Link_ProcessSlaveData_SkipLampDataUse:
    rjmp Lamp_ReapplyOnOff
