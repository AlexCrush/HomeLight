    25: ;-----------------------------------------------------------------
    26: ; Переменные для кнопки без фиксации
    27: ; T1 с последнего перехода 0->1
    28: ; в момент T1 > TShort фиксируем событие "короткое нажатие"
    29: ; в момент T1 > Tlong  фиксируем событие "долгое нажатие"
    30: ; каждый 0 на входе делает T1 := 0
    31: ; больше максимума не увеличиваем
    32: ;
    33: 
    34: .equ InputStateRecordLen = 1
    35: .equ InputState_Disp_T1 = 0
    36: 
    37: InputStates:
