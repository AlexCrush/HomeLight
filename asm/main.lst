   150: 000134   9509  icall ; got bless us!
   151: 000135   CFDB  rjmp Lamp_ApplyActionExit
   152: ;-------------------------------------------------------
   153: ; IN: tmp1 - action (LampAction_Off/On/Switch)
   154: ;     tmp - lamp
   155: 
   156: Lamp_Do_OffOnSwitch:
   157: 000136   931F  push tmp1 ; action
   158:     LDIRamAddrZ LampState
   159: 000139   DFAE  rcall Lamp_AddOffsetGetMask
   160: 00013A   2F32  mov tmp3, tmp2
   161: 00013B   9530  com tmp3
   162:     ; tmp1 - offset
   163:     ; tmp2 - OR mask  00010000
   164:     ; tmp3 - AND mask 11101111
   165: 00013C   910F  pop tmp
   166: 
   167: 00013D   3001  cpi tmp, LampAction_Off
   168: 00013E   F029  breq Lamp_Do_Off
   169: 00013F   3002  cpi tmp, LampAction_On
   170: 000140   F099  breq Lamp_Do_On
   171: 
   172:     ; switch otherwise
   173: 000141   8100  ld tmp, Z
   174: 000142   2302  and tmp, tmp2
   175: 000143   F081  breq Lamp_Do_On
   176: Lamp_Do_Off:
   177: 000144   8100  ld tmp, Z
   178: 000145   2303  and tmp, tmp3
   179: 000146   8300  st Z, tmp
   180:     LDIRamAddrZ LampStateMaskOn
   181: 000149   DF9F  rcall Lamp_AddOffset
   182: 00014A   8100  ld tmp, Z
   183: 00014B   2303  and tmp, tmp3
   184: 00014C   8300  st Z, tmp
   185:     LDIRamAddrZ LampStateMaskOff
