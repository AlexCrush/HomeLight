   196:     LDIRamAddrZ LampStateMaskOn
   197: 000159   DF8F  rcall Lamp_AddOffset
   198: 00015A   8100  ld tmp, Z
   199: 00015B   2B02  or tmp, tmp2
   200: 00015C   8300  st Z, tmp
   201:     LDIRamAddrZ LampStateMaskOff
   202: 00015F   DF89  rcall Lamp_AddOffset
   203: 000160   8100  ld tmp, Z
   204: 000161   2303  and tmp, tmp3
   205: 000162   8300  st Z, tmp
   206: 000163   9508  ret
   207: 
   208: ;-------------------------------------------------------
   209: Lamp_SetOffTimer:
   210: ; in: tmp2 - lamp id
   211: ;     tmp3 - timer value
   212: 
   213:     ; pass 1 - try find entry with same lamp id
   214: 000164   E014  ldi tmp1, MaxOffTimers
   215:     LDIRamAddrZ LampOffTimers
   216: Lamp_SetOffTimer_TryNext:
   217: 000167   9101  ld tmp, Z+
   218: 000168   9101  ld tmp, Z+
   219: 000169   1702  cp tmp, tmp2
   220: 00016A   F061  breq Lamp_SetOffTimer_UseAddr
   221: 00016B   951A  dec tmp1
   222: 00016C   F7D1  brne Lamp_SetOffTimer_TryNext
   223: 
   224:     ; pass 2 - try find entry with zero timeout
   225: 00016D   E014  ldi tmp1, MaxOffTimers
   226:     LDIRamAddrZ LampOffTimers
   227: Lamp_SetOffTimer_TryNext2:
   228: 000170   9101  ld tmp, Z+
   229: 000171   2300  tst tmp
   230: 000172   9101  ld tmp, Z+
   231: 000173   F019  breq Lamp_SetOffTimer_UseAddr
   232: 000174   951A  dec tmp1
   233: 000175   F7D1  brne Lamp_SetOffTimer_TryNext2
   234:     ;  oops no empty cells for timer
   235: 000176   9508  ret
   236: 
   237: Lamp_SetOffTimer_UseAddr:
   238: 000177   9732  sbiw zL, 2
   239: 000178   9331  st Z+, tmp3  ; timer val
   240: 000179   8320  st Z, tmp2   ; lamp id
   241: 00017A   9508  ret
   242: ;-------------------------------------------------------
   243: Lamp_TickOffTimers:
   244: 00017B   E034  ldi tmp3, MaxOffTimers
   245:     LDIRamAddrZ LampOffTimers
   246: Lamp_TickOffTimers_Loop:
   247: 00017E   9101  ld tmp, Z+
   248: 00017F   9121  ld tmp2, Z+
   249: 000180   2300  tst tmp
   250: 000181   F071  breq Lamp_TickOffTimers_Loop_Next
   251: 000182   9732  sbiw zL, 2
   252: 000183   950A  dec tmp
   253: 000184   9301  st Z+, tmp
   254: 000185   9631  adiw zL, 1
   255: 000186   2300  tst tmp
   256: 000187   F441  brne Lamp_TickOffTimers_Loop_Next
   257:     ; Do off!
   258: 000188   93EF  push zL
   259: 000189   93FF  push zH
   260: 00018A   933F  push tmp3
   261: 00018B   E011  ldi tmp1, LampAction_Off
   262:     ; tmp2 - lamp id
   263: 00018C   DF74  rcall Lamp_ApplyAction
   264: 00018D   913F  pop tmp3
   265: 00018E   91FF  pop zH
   266: 00018F   91EF  pop zL
   267: Lamp_TickOffTimers_Loop_Next:
   268: 000190   953A  dec tmp3
   269: 000191   F761  brne Lamp_TickOffTimers_Loop
   270: 000192   9508  ret
   271: ;-------------------------------------------------------
   272: Lamp_ReapplyOnOff:
   273:     ; Reapply On
   274:     LDIRamAddrZ LampState
   275:     LDIRamAddrY LampStateMaskOn
   276: 000197   E038  ldi tmp3, LampBytes
   277: Lamp_ReapplyOnLoop:
   278: 000198   8100  ld tmp, Z      ; 01011100
   279: 000199   8118  ld tmp1, Y     ; 01000001
   280: 00019A   2F20  mov tmp2, tmp
   281: 00019B   9520  com tmp2       ; 10100011
   282: 00019C   2312  and tmp1, tmp2 ; 00000001
   283: 00019D   2B01  or tmp, tmp1
   284: 00019E   9301  st Z+, tmp
   285: 00019F   9319  st Y+, tmp1
   286: 0001A0   953A  dec tmp3
   287: 0001A1   F7B1  brne Lamp_ReapplyOnLoop
   288: 
   289: ; Reapply Off
   290:     LDIRamAddrZ LampState
   291:     LDIRamAddrY LampStateMaskOff
   292: 0001A6   E038  ldi tmp3, LampBytes
   293: Lamp_ReapplyOffLoop:
   294: 0001A7   8100  ld tmp, Z      ; 01011100
   295: 0001A8   8118  ld tmp1, Y     ; 01000001
   296: 0001A9   2310  and tmp1, tmp  ; 01000000
   297: 0001AA   9510  com tmp1
   298: 0001AB   2301  and tmp, tmp1
   299: 0001AC   9510  com tmp1
   300: 0001AD   9301  st Z+, tmp
   301: 0001AE   9319  st Y+, tmp1
   302: 0001AF   953A  dec tmp3
   303: 0001B0   F7B1  brne Lamp_ReapplyOffLoop
   304: 0001B1   9508  ret
   305: ;-------------------------------------------------------
