    52: Inputs_Poll:
    53:     LDIProgMemAddrZ InputsPortTable
    54:     LDIRamAddrY InputStates
    55: 
    56: 0001E8   2722  clr tmp2       ; input NR
    57: Inputs_Poll_Loop:
    58: 0001E9   9115  lpm tmp1, Z+   ; bit
    59: 0001EA   2311  tst tmp1
    60: 0001EB   F189  breq Inputs_Poll_LoopEnd
    61: 0001EC   91A5  lpm xL, Z+     ; DD - ignore
    62: 0001ED   91A5  lpm xL, Z+     ; Port - ignore
    63: 0001EE   91A5  lpm xL, Z+     ; Pin
    64: 0001EF   93EF  push zL
    65: 0001F0   93FF  push zH
    66: 0001F1   27EE  clr zL
    67: 0001F2   27FF  clr zH
    68: 
    69: 0001F3   27BB  clr xH
    70: 0001F4   910C  ld tmp, X      ; read pin
    71: 
    72: 0001F5   2301  and tmp, tmp1  ; get bit
    73: 0001F6   8108  ldd tmp, Y + InputState_Disp_T1
    74: 0001F7   F051  breq Inputs_Poll_Loop_Pressed
    75: ;Released!
