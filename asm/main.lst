     1: ; Packet format:
     2: ; Input
     3: ; 0  : 0xAB
     4: ; 1  : DeviceID == ConfigID
     5: ; 2  : LampStateKnown (from master)
     6: ; 3-10: LampState (64 bits)
     7: ; 11-12: CRC
     8: ;
     9: ; Output:
    10: ; 0  : 0xCD
    11: ; 1  : DeviceID == ConfigID
    12: ; 2  : LampStateKnown (from slave)
    13: ; 3-10: LampState
    14: ; 11-12: CRC
    15: 
