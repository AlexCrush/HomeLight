     4: Radio_Init:
     5: 0002E4   9A8B  sbi DD_Radio, BIT_Radio
     6: 0002E5   9893  cbi Port_Radio, BIT_Radio
     7: 0002E6   2700  clr tmp
     8: 0002E7   9300  sts RadioSendPosition, tmp
        0002E8   009E
     9: 0002E9   9300  sts RadioSendPosition+1, tmp
        0002EA   009F
    10: 0002EB   9300  sts RadioSendBytesLeft, tmp
        0002EC   00A0
    11: 0002ED   9300  sts RadioSendMask, tmp
        0002EE   009D
    12: 0002EF   9300  sts RadioSendLampId, tmp
        0002F0   00A1
    13: 0002F1   9300  sts RadioSendRepeatsLeft, tmp
        0002F2   00A2
