    34: 000302   2322  tst tmp2
    35: 000303   F071  breq Radio_ProcessInputs_CheckNewSend
    36:     ; Закончили одну посылку по какой-то лампе, но может надо повторить
    37: 000304   9100  lds tmp, RadioSendRepeatsLeft
