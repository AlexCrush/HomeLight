    18: .equ Org_RelayToLamp        = 0x000
    19: .equ Org_ShortPressConfig   = 0x010
    20: .equ Org_ShortReleaseConfig = 0x030
    21: .equ Org_LongPressConfig    = 0x050
    22: .equ Org_LongReleaseConfig  = 0x070
    23: 
    24: ;-----------------------------------------------------------------
    25: ; Реле перепутаны напрочь :-)
    26: ; Порядок в config (бит в Relay_DirectWrite ) | Номер контакта на плате, слева направо: 012345678, 8 - общий
    27: ; 0 | 3
    28: ; 1 | 1
    29: ; 2 | 5
    30: ; 3 | 7
    31: ; 4 | 6
    32: ; 5 | 4
    33: ; 6 | 2
    34: ; 7 | 0
    35: 
    36: ; RelayX = Логическая нумерация, соответствует контакту на плате
    37: .equ Relay0 = 1 << 7
    38: .equ Relay1 = 1 << 1
    39: .equ Relay2 = 1 << 6
    40: .equ Relay3 = 1 << 0
    41: .equ Relay4 = 1 << 5
    42: .equ Relay5 = 1 << 2
    43: .equ Relay6 = 1 << 4
    44: .equ Relay7 = 1 << 3
    45: ;-----------------------------------------------------------------
    46: ; Всего 64 лампочки MAX
    47: ; Конфиг каждого реле:
    48: ; Номер лампочки, FF если реле не используется
    49: ;
    50: ;
    51: ;   Нажали -> сразу ShortPress
    52: ;   Отпустили быстро -> ShortRelease
    53: ;   Держим дольше - LongPress
    54: ;   Отпустили -> LongRelease
    55: 
    56: .macro LOffAll
    57:       .db @0, LampAction_OffAll, 0, 0
    58: .endmacro
    59: 
    60: .macro LOff
    61:       .db @0, LampAction_Off, @1, 0
    62: .endmacro
    63: 
    64: .macro LOn
    65:       .db @0, LampAction_On, @1, 0
    66: .endmacro
    67: 
    68: .macro LSw
    69:       .db @0, LampAction_Switch, @1, 0
    70: .endmacro
    71: 
    72: .macro LCopyFrom
    73:       .db @0, LampAction_CopyFrom, @1, @2
    74: .endmacro
    75: 
    76: .macro LSetOffTimer
    77:       .db @0, LampAction_SetOffTimer, @1, @2
    78: .endmacro
    79: 
    80: .macro LCustomAction
    81:       .db @0, LampAction_Custom, LOW(@1), HIGH(@1)
    82: .endmacro
    83: 
