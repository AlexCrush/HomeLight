    71:     LDIRamAddrZ LampState
    72: 0000F9   DFEE  rcall Lamp_AddOffsetGetMask
    73: 0000FA   8100  ld tmp, Z
    74: 0000FB   2302  and tmp, tmp2
    75: 0000FC   912F  pop tmp2
    76: 0000FD   911F  pop tmp1
    77: 0000FE   91FF  pop zH
    78: 0000FF   91EF  pop zL
    79: 000100   9508  ret
    80: ;-------------------------------------------------------
    81: Lamp_ApplyAction:
    82: ; in:
    83: ;   tmp1 Action
    84: ;   tmp2 arg0 (LampNo)
    85: ;   tmp3 arg1 (various)
    86: 000101   93EF  push zL
    87: 000102   93FF  push zH
    88: 000103   3010  cpi tmp1, LampAction_OffAll
    89: 000104   F079  breq Lamp_ApplyAction_OffAll
    90: 
    91: 000105   3011  cpi tmp1, LampAction_Off
    92: 000106   F141  breq Lamp_ApplyAction_OffOnSwitch
    93: 000107   3012  cpi tmp1, LampAction_On
    94: 000108   F131  breq Lamp_ApplyAction_OffOnSwitch
    95: 000109   3013  cpi tmp1, LampAction_Switch
    96: 00010A   F121  breq Lamp_ApplyAction_OffOnSwitch
    97: 
    98: 00010B   3014  cpi tmp1, LampAction_CopyFrom
    99: 00010C   F0A1  breq Lamp_ApplyAction_CopyFrom
   100: 
   101: 00010D   3015  cpi tmp1, LampAction_SetOffTimer
   102: 00010E   F0F1  breq Lamp_ApplyAction_SetOffTimer
   103: 
   104: 00010F   3016  cpi tmp1, LampAction_Custom
   105: 000110   F109  breq Lamp_ApplyAction_Custom
   106: 
   107: ; Uknown action
   108: Lamp_ApplyActionExit:
   109: 000111   91FF  pop zH
   110: 000112   91EF  pop zL
   111: 000113   9508  ret
   112: 
   113: Lamp_ApplyAction_OffAll:
   114: 000114   2700  clr tmp
   115:     LDIRamAddrZ LampState
   116: 000117   DFBF  rcall LampWriteAllBytes
   117: 000118   2700  clr tmp
   118:     LDIRamAddrZ LampStateMaskOn
   119: 00011B   DFBB  rcall LampWriteAllBytes
   120: 00011C   EF0F  ser tmp
   121:     LDIRamAddrZ LampStateMaskOff
   122: 00011F   DFB7  rcall LampWriteAllBytes
   123: 000120   CFF0  rjmp Lamp_ApplyActionExit
   124: 
   125: Lamp_ApplyAction_CopyFrom:
   126: 000121   932F  push tmp2 ; Destination lamp id
   127: 000122   2F03  mov tmp, tmp3
   128:     LDIRamAddrZ LampState
   129: 000125   DFC2  rcall Lamp_AddOffsetGetMask
   130: 000126   8100  ld tmp, Z
   131: 000127   2302  and tmp, tmp2
   132: 000128   912F  pop tmp2
   133: 000129   E011  ldi tmp1, LampAction_Off
   134: 00012A   F021  breq Lamp_ApplyAction_OffOnSwitch
   135: 00012B   E012  ldi tmp1, LampAction_On
   136: 00012C   C002  rjmp Lamp_ApplyAction_OffOnSwitch
   137: 
   138: Lamp_ApplyAction_SetOffTimer:
   139: 00012D   D036  rcall Lamp_SetOffTimer
   140: 00012E   CFE2  rjmp Lamp_ApplyActionExit ; todo
   141: 
   142: Lamp_ApplyAction_OffOnSwitch:
