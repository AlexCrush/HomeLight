   209: .include "link_l2.asm-inc"
  Including file link_l2.asm-inc
     1: ; Pause consists of 100 bits.
     2: ; One bit is CPU_Freq / Usart_Freq cycles
     3: .equ LinkPauseCycles = 100 * FREQ_MHZ * 1000000 / RS485_BaudRate
     4: .equ LinkPauseLoops = LinkPauseCycles / 6 ; length of one loop
     5: 
     6: 
     7: ; Wire byte encoding:
     8: ;  0xFH0L - first byte (HighLow nibbles)
     9: ;  0x0H0L - other bytes
    10: ;
    11: 
    12: ;----------------------------------------------------------------------------------
    13: ;----------------------------------------------------------------------------------
    14: ;--------------------------------------------------------------------
    15: L2_SendNoCRC:
    16: 000232   9854  cbi UCSRB, RXEN
    17: 000233   9A96  sbi Port_RS485DIR, BIT_RS485DIR     ; RS485 - Out
    18: 000234   9A5E  sbi UCSRA, TXC
    19: 000235   B90C  out UDR, tmp
    20: L2_SendWait:
    21: 000236   9B5E  sbis UCSRA, TXC
    22: 000237   CFFE  rjmp L2_SendWait
    23: 000238   9896  cbi Port_RS485DIR, BIT_RS485DIR     ; RS485 - In
    24: 000239   9A54  sbi UCSRB, RXEN
    25: 00023A   9508  ret
    26: ;--------------------------------------------------------------------
    27: L2_SendFirstByte:
    28: 00023B   EFAF  ser xL
    29: 00023C   EFBF  ser xH
    30: 00023D   D04C  rcall L2_UpdateCRC
    31: 00023E   930F  push tmp
    32: 00023F   9502  swap tmp
    33: 000240   700F  andi tmp, 0x0F
    34: 000241   6F00  ori tmp, 0xF0
    35: 000242   DFEF  rcall L2_SendNoCRC
    36: 000243   910F  pop tmp
    37: 000244   700F  andi tmp, 0x0F
    38: 000245   CFEC  rjmp L2_SendNoCRC
    39: ;--------------------------------------------------------------------
    40: L2_SendNotFirstByte:
    41: 000246   D043  rcall L2_UpdateCRC
    42: L2_SendNotFirstByteNoCRC:
    43: 000247   930F  push tmp
    44: 000248   9502  swap tmp
    45: 000249   700F  andi tmp, 0x0F
    46: 00024A   DFE7  rcall L2_SendNoCRC
    47: 00024B   910F  pop tmp
    48: 00024C   700F  andi tmp, 0x0F
    49: 00024D   CFE4  rjmp L2_SendNoCRC
    50: ;--------------------------------------------------------------------
    51: L2_SendCRC:
    52: ; CRC bytes are swapped
    53: 00024E   2F0A  mov tmp, xL
    54: 00024F   DFF7  rcall L2_SendNotFirstByteNoCRC
    55: 000250   2F0B  mov tmp, xH
    56: 000251   CFF5  rjmp L2_SendNotFirstByteNoCRC
    57: ;--------------------------------------------------------------------
    58: 
    59: L2_RecvByteComplex:
    60: ; in: tmp1 = F0 - expect first, 00 - expect not first
    61: ; ret: Z = ok, tmp - data
    62: ; NZ - timeout / decode error
    63: 000252   931F  push tmp1
    64: 000253   D025  rcall L2_RecvNoCrc
    65: 000254   911F  pop tmp1
    66: 000255   F481  brne L2_RecvByteComplex_Exit
    67: 000256   930F  push tmp
    68: 000257   7F00  andi tmp, 0xF0
    69: 000258   1701  cp tmp, tmp1
    70: 000259   911F  pop tmp1
    71: 00025A   F459  brne L2_RecvByteComplex_Exit
    72: 
    73: 00025B   701F  andi tmp1, 0x0F
    74: 00025C   9512  swap tmp1
    75: 
    76: 00025D   D01B  rcall L2_RecvNoCrc
    77: 00025E   F439  brne L2_RecvByteComplex_Exit
    78: 00025F   930F  push tmp
    79: 000260   7F00  andi tmp, 0xF0
    80: 000261   910F  pop tmp
    81: 000262   F419  brne L2_RecvByteComplex_Exit
    82: 000263   700F  andi tmp, 0x0F
    83: 000264   2B01  or tmp, tmp1
    84: 000265   9418  sez
    85: L2_RecvByteComplex_Exit:
    86: 000266   9508  ret
    87: ;--------------------------------------------------------------------
    88: ; ret: Z = ok, tmp - data
    89: ; NZ - timeout / decode error
    90: L2_RecvFirstByte:
    91: 000267   EFAF  ser xL
    92: 000268   EFBF  ser xH
    93: 000269   931F  push tmp1
    94: 00026A   EF10  ldi tmp1, 0xF0
    95: 00026B   DFE6  rcall L2_RecvByteComplex
    96: 00026C   911F  pop tmp1
    97: 00026D   F411  brne L2_RecvFirstByte_Exit
    98: 00026E   D01B  rcall L2_UpdateCRC
    99: 00026F   9418  sez
   100: L2_RecvFirstByte_Exit:
   101: 000270   9508  ret
   102: ;--------------------------------------------------------------------
   103: ; ret: Z = ok, tmp - data
   104: ; NZ - timeout / decode error
   105: L2_RecvNotFirstByte:
   106: 000271   931F  push tmp1
   107: 000272   E010  ldi tmp1, 0x00
   108: 000273   DFDE  rcall L2_RecvByteComplex
   109: 000274   911F  pop tmp1
   110: 000275   F411  brne L2_RecvNotFirstByte_Exit
   111: 000276   D013  rcall L2_UpdateCRC
   112: 000277   9418  sez
   113: L2_RecvNotFirstByte_Exit:
   114: 000278   9508  ret
   115: ;--------------------------------------------------------------------
   116: L2_RecvNoCrc:
   117: ; ret: Z = ok, tmp - data
   118: ; NZ - timeout
   119: 000279   93EF  push zL
   120: 00027A   93FF  push zH
   121: 
   122:     LDIWZ LinkPauseLoops
   123: L2_Recv_Wait:
   124: 00027D   995F  sbic UCSRA, RXC   ; 1 + 1
   125: 00027E   C006  rjmp L2_Recv_Recv ; 0
   126: 00027F   9731  sbiw zL, 1        ; 2
   127: 000280   F7E1  brne L2_Recv_Wait ; 2
   128: 000281   91FF  pop zH
   129: 000282   91EF  pop zL
   130: 000283   9498  clz
   131: 000284   9508  ret
   132: 
   133: L2_Recv_Recv:
   134: 000285   B10C  in tmp, UDR
   135: 000286   91FF  pop zH
   136: 000287   91EF  pop zL
   137: 000288   9418  sez
   138: 000289   9508  ret
   139: ;--------------------------------------------------------------------
   140: L2_UpdateCRC:
   141: 00028A   930F  push tmp
   142: 00028B   931F  push tmp1
   143: 00028C   932F  push tmp2
   144: 00028D   EA10  ldi tmp1, 0xA0
   145: 00028E   E021  ldi tmp2, 0x01
   146: 00028F   27A0  eor xL, tmp
   147: 000290   E008  ldi tmp, 8
   148: L2_UpdateCRC_BitLoop:
   149: 000291   9488  clc
   150: 000292   95B7  ror xH
   151: 000293   95A7  ror xL
   152: 000294   F410  brcc L2_UpdateCRC_Handle1
   153: 000295   27B1  eor xH, tmp1
   154: 000296   27A2  eor xL, tmp2
   155: L2_UpdateCRC_Handle1:
   156: 000297   950A  dec tmp
   157: 000298   F7C1  brne L2_UpdateCRC_BitLoop
   158: 000299   912F  pop tmp2
   159: 00029A   911F  pop tmp1
   160: 00029B   910F  pop tmp
   161: 00029C   9508  ret
   162: ;--------------------------------------------------------------------
   163: L2_RecvCRC:
   164: 00029D   2711  clr tmp1
   165: 00029E   DFB3  rcall L2_RecvByteComplex
   166: 00029F   F441  brne L2_RecvCRC_Exit
   167: 
   168: 0002A0   930F  push tmp
   169: 0002A1   2711  clr tmp1
   170: 0002A2   DFAF  rcall L2_RecvByteComplex
   171: 0002A3   911F  pop tmp1
   172: 0002A4   F419  brne L2_RecvCRC_Exit
   173: 
   174: ; Note that X holds swapped CRC
   175: 0002A5   170B  cp tmp, xH
   176: 0002A6   F409  brne L2_RecvCRC_Exit
   177: 0002A7   171A  cp tmp1, xL
   178: L2_RecvCRC_Exit:
   179: 0002A8   9508  ret
   180: ;----------------------------------------------------------------------------------
