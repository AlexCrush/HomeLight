    62: 0000EF   3400  cpi tmp, LampCount
    63: 0000F0   F010  brcs Lamp_GetState
    64: 0000F1   2700  clr tmp
    65: 0000F2   9508  ret
    66: Lamp_GetState:
    67: 0000F3   93EF  push zL
    68: 0000F4   93FF  push zH
