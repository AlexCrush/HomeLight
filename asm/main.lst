    24: 0000D8   9301  st Z+, tmp
    25: 0000D9   951A  dec tmp1
    26: 0000DA   F7E9  brne LampWriteBytesLoop
    27: 0000DB   9508  ret
    28: ;-------------------------------------------------------
    29: Lamp_GetOffsetAndMask:
    30: ; in: tmp - lamp index
    31: ; out:
    32: ;      tmp1 - lamp offset
    33: ;      tmp2 - lamp bit mask  (00001000)
    34: 0000DC   930F  push tmp
    35: 0000DD   E021  ldi tmp2, 1
    36: 0000DE   7007  andi tmp, 7
    37: 0000DF   F019  breq Lamp_GetOffsetAndMask_BitLoopEnd
    38: Lamp_GetOffsetAndMask_BitLoop:
    39: 0000E0   0F22  lsl tmp2
    40: 0000E1   950A  dec tmp
    41: 0000E2   F7E9  brne Lamp_GetOffsetAndMask_BitLoop
    42: Lamp_GetOffsetAndMask_BitLoopEnd:
    43: 0000E3   911F  pop tmp1
    44: 0000E4   9516  lsr tmp1
    45: 0000E5   9516  lsr tmp1
    46: 0000E6   9516  lsr tmp1
    47: 0000E7   9508  ret
    48: ;-------------------------------------------------------
    49: Lamp_AddOffsetGetMask:
    50: 0000E8   DFF3  rcall Lamp_GetOffsetAndMask
    51: Lamp_AddOffset:
    52: 0000E9   932F  push tmp2
    53: 0000EA   2722  clr tmp2
    54: 0000EB   0FE1  add zL, tmp1
    55: 0000EC   1FF2  adc zH, tmp2
    56: 0000ED   912F  pop tmp2
    57: 0000EE   9508  ret
    58: ;-------------------------------------------------------
    59: Lamp_GetStateSafe:
