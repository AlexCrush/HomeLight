    17: 0002F4   E710  ldi tmp1, Low(Radio_Tick_Period_Cycles)
    18: 0002F5   BD0B  out OCR1AH, tmp
    19: 0002F6   BD1A  out OCR1AL, tmp1
    20: 
    21: 0002F7   E000  ldi tmp, 0b00000000  ; CTC mode
    22: 0002F8   BD0F  out TCCR1A, tmp
    23: 0002F9   E009  ldi tmp, 0b00001001  ; CTC mode, ClockSource =  Fclk
    24: 0002FA   BD0E  out TCCR1B, tmp
    25: 
    26: 0002FB   9508  ret
    27: 
