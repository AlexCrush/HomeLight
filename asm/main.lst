    18: 0001CC   9115  lpm tmp1, Z+   ; Bit
    19: 0001CD   2311  tst tmp1
    20: 0001CE   F061  breq Inputs_Init_LoopEnd
    21: 0001CF   2F21  mov tmp2, tmp1
    22: 0001D0   9520  com tmp2       ; Mask
    23: 0001D1   91A5  lpm xL, Z+     ; DD
    24: 
    25: 0001D2   910C  ld tmp, X      ; Read DD
    26: 0001D3   2302  and tmp, tmp2  ; Input!
    27: 0001D4   930C  st X, tmp      ; Write DD
    28: 
    29: 
    30: 0001D5   91A5  lpm xL, Z+     ; Port
    31: 0001D6   910C  ld tmp, X      ; Read Port
    32:     ;! and tmp, tmp2  ;
    33: 0001D7   2B01  or tmp, tmp1   ; PullUp
    34: 0001D8   930C  st X, tmp
    35: 0001D9   9631  adiw zL, 1     ; Skip Pin
    36: 0001DA   CFF1  rjmp Inputs_Init_Loop
    37: 
    38: Inputs_Init_LoopEnd:
    39: 
    40:     LDIRamAddrZ InputStates
    41: 0001DD   E018  ldi tmp1, InputCount * InputStateRecordLen
