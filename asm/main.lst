    22: 0002AD   F7D9  brne LinkLoop
    23: 
    24: 
    25: 0002AE   DFC2  rcall L2_RecvNotFirstByte ; device id
    26: 0002AF   F7C9  brne LinkLoop
    27: 
    28: 0002B0   3001  cpi tmp, ConfigId ; не по нашу душу
    29: 0002B1   F7B9  brne LinkLoop
    30: 
    31: 
