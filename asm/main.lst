   101: 00020E   2F0E  mov tmp, zL
   102: 00020F   2B0F  or tmp, zH
   103: 000210   F039  breq Inputs_Poll_Loop_Next_NotCall
   104: 
   105: 000211   93DF  push yH
   106: 000212   93CF  push yL
   107: 000213   932F  push tmp2
   108: 000214   D009  rcall Inputs_ProcessAction
   109: 000215   912F  pop tmp2
   110: 000216   91CF  pop yL
   111: 000217   91DF  pop yH
