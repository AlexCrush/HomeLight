    77: 0001F9   F030  brcs Inputs_Poll_Loop_ReleasedNext ; Was pressed for too short
    78: 0001FA   3302  cpi tmp, LongPress
    79:     LDIConfigAddrZ LongReleaseConfig
    80: 0001FD   F410  brcc Inputs_Poll_Loop_ReleasedLong
    81:     LDIConfigAddrZ ShortReleaseConfig
    82: Inputs_Poll_Loop_ReleasedLong:
    83: Inputs_Poll_Loop_ReleasedNext:
    84: 000200   2700  clr tmp
    85: 000201   C00B  rjmp Inputs_Poll_Loop_Next
    86: 
    87: Inputs_Poll_Loop_Pressed:
    88: ; Pressed
    89: 000202   3F0F  cpi tmp, 255
    90: 000203   F049  breq Inputs_Poll_Loop_Next ; Pressed for too long
    91: 000204   9503  inc tmp
    92: 000205   3005  cpi tmp, ShortPress
    93: 000206   F411  brne Inputs_Poll_Loop_NotShort
    94:     LDIConfigAddrZ ShortPressConfig
