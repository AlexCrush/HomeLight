   268: 
   269: CustomAction_SU2Light:
   270:     ; Если основной свет включен - выключить
   271:     ldi tmp1, LampAction_Off
   272:     ldi tmp, Lamp_Toilet2
   273:     rcall Lamp_GetStateSafe
   274:     tst tmp
   275:     brne CustomAction_SU2Light_Off
   276:     ; Если включен флаг - то будем включать свет вне зависимости от зеркала
   277:     ldi tmp, Lamp_Toilet2HintOn
   278:     rcall Lamp_GetStateSafe
   279:     tst tmp
   280:     brne CustomAction_SU2Light_On
   281:     ; Если зеркало включено - то надо выключать свет
   282:     ldi tmp, Lamp_Toilet2Mirror
   283:     rcall Lamp_GetStateSafe
   284:     tst tmp
   285:     brne CustomAction_SU2Light_Off
   286: CustomAction_SU2Light_On:
   287:     ldi tmp1, LampAction_On
   288: 
   289: CustomAction_SU2Light_Off:
   290:     push tmp1
   291:     ldi tmp, Lamp_Toilet2
   292:     rcall Lamp_Do_OffOnSwitch
   293:     pop tmp1
   294:     ldi tmp, Lamp_Toilet2Mirror
   295:     rjmp Lamp_Do_OffOnSwitch
   296: .endif
