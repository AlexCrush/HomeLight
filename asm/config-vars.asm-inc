.if ConfigId == 100 ; debug
;ConfigORG  Org_RelayToLamp
RelayToLamp:
    .db Relay0, 0
    .db Relay1, 1
    .db Relay2, 2
    .db Relay3, 3
    .db Relay4, 4
    .db Relay5, 5
    .db Relay6, 6
    .db Relay7, 7
    .db 0xFF, 0xFF

;ConfigORG Org_ShortPressConfig
ShortPressConfig:
    LSw 0, 0
    LSw 1, 1
    LSw 2, 2
    LSw 3, 3
    LSw 4, 4
    LSw 5, 5
    LSw 6, 6
    LSw 7, 7
    .db 0xFF, 0xFF

ConfigORG  Org_ShortReleaseConfig
ShortReleaseConfig:
    .db 0xFF, 0xFF


ConfigORG  Org_LongPressConfig
LongPressConfig:
    .db 0xFF, 0xFF

ConfigORG  Org_LongReleaseConfig
LongReleaseConfig:
    .db 0xFF, 0xFF


.endif

.if UseRadio == 1
.equ RadioData_Len = 32
.equ RadioData_RepeatCount = 16
RadioData_ProjectorScreenDown:
    .db 255, 255, 243, 77, 36, 219, 105, 54, 210, 109, 166, 219, 105, 166, 146, 73, 36, 154, 73, 36, 146, 105, 36, 218, 105, 182, 155, 0, 0, 0, 0, 0

RadioData_ProjectorScreenUp:
    .db 255, 255, 243, 77, 36, 219, 105, 54, 210, 109, 166, 219, 105, 166, 146, 73, 36, 154, 73, 36, 146, 73, 52, 218, 77, 38, 155, 0, 0, 0, 0, 0

RadioData_ProjectorScreenStop:
    .db 255, 255, 243, 77, 36, 219, 105, 54, 210, 109, 166, 219, 105, 166, 146, 73, 36, 154, 73, 36, 146, 77, 36, 218, 77, 182, 155, 0, 0, 0, 0, 0
.endif
