; Packet format:
; Input
; 0  : 0xAB
; 1  : DeviceID == ConfigID
; 2  : LampStateKnown (from master)
; 3-10: LampState (64 bits)
; 11-12: CRC
;
; Output:
; 0  : 0xCD
; 1  : DeviceID == ConfigID
; 2  : LampStateKnown (from slave)
; 3-10: LampState
; 11-12: CRC

LinkLoop:
    sei

    rcall L2_RecvFirstByte
    brne LinkLoop
    cpi tmp, 0xAB
    brne LinkLoop


    rcall L2_RecvNotFirstByte ; device id
    brne LinkLoop

    cpi tmp, ConfigId ; не по нашу душу
    brne LinkLoop


    rcall L2_RecvNotFirstByte ; LampStateKnown
    brne LinkLoop
    sts LampStateKnownExt, tmp

    LDIRamAddrZ LampStateExt
    ldi tmp1, LampBytes
LinkLoop_ReadLampBytes:
    rcall L2_RecvNotFirstByte
    brne LinkLoop
    st Z+, tmp
    dec tmp1
    brne LinkLoop_ReadLampBytes

    rcall L2_RecvCRC
    brne LinkLoop

;    rcall WAIT_1_Milli

    cli
    rcall Link_ProcessSlaveData
    ser tmp
    sts Communicated, tmp
    sei

    ldi tmp, 0xCD
    rcall L2_SendFirstByte

    ldi tmp, ConfigId
    rcall L2_SendNotFirstByte
    lds tmp, LampStateKnown
    rcall L2_SendNotFirstByte

    LDIRamAddrZ LampState
    ldi tmp1, LampBytes
LinkLoop_SendLampBytes:
    ld tmp, Z+
    rcall L2_SendNotFirstByte
    dec tmp1
    brne LinkLoop_SendLampBytes

    rcall L2_SendCRC

    rjmp LinkLoop

.include "link_l7_common.asm-inc"














